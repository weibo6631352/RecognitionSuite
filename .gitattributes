* text=auto

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

/docs/requirements-source/*.jpg filter=lfs diff=lfs merge=lfs -text
/testdata/**/*.jpg filter=lfs diff=lfs merge=lfs -text
/testdata/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
/testdata/**/*.png filter=lfs diff=lfs merge=lfs -text
/testdata/**/*.bmp filter=lfs diff=lfs merge=lfs -text
/testdata/**/*.tif filter=lfs diff=lfs merge=lfs -text
/testdata/**/*.tiff filter=lfs diff=lfs merge=lfs -text
/testdata/**/*.webp filter=lfs diff=lfs merge=lfs -text
/testdata/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
/testdata/**/*.wav filter=lfs diff=lfs merge=lfs -text
/testdata/acceptance/**/*.txt text eol=lf

# Reviewed SDK baselines are versioned deliverables. Keep their large binary
# payloads in LFS while leaving headers, CMake files, docs, and manifests as
# ordinary reviewable Git content. Disable line-ending conversion for the
# published snapshot so its SHA-256 manifest is stable after a fresh checkout;
# do not rewrite upstream snapshot whitespace during repository checks.
/sdk/** -text
/sdk/** -whitespace
/sdk/**/*.dll filter=lfs diff=lfs merge=lfs -text
/sdk/**/*.exe filter=lfs diff=lfs merge=lfs -text
/sdk/**/*.lib filter=lfs diff=lfs merge=lfs -text
/sdk/**/*.dylib filter=lfs diff=lfs merge=lfs -text
/sdk/**/*.metallib filter=lfs diff=lfs merge=lfs -text
/sdk/**/*.onnx filter=lfs diff=lfs merge=lfs -text
/sdk/**/*.ftz filter=lfs diff=lfs merge=lfs -text
/sdk/**/*.gguf filter=lfs diff=lfs merge=lfs -text
/sdk/**/*.gguf.part* filter=lfs diff=lfs merge=lfs -text
/sdk/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
/sdk/**/*.safetensors.part* filter=lfs diff=lfs merge=lfs -text
/sdk/**/bin/models/**/tokenizer.json filter=lfs diff=lfs merge=lfs -text
/sdk/**/bin/models/**/vocab.json filter=lfs diff=lfs merge=lfs -text
/sdk/**/bin/models/**/merges.txt filter=lfs diff=lfs merge=lfs -text
